{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/tudou-proxy.js": {
      "maxDuration": 300,
      "supportsCancellation": true
    },
    "api/apimart-image.js": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/account.js": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/account/:path*",
      "destination": "/api/account"
    },
    {
      "source": "/api/tudou/:path*",
      "destination": "/api/tudou-proxy"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/account/cron/balances",
      "schedule": "0 1 * * *"
    }
  ]
}
